[configuration]

entry_symbol = "sandbox_library_init"
compatibility_minimum = 4.1

[libraries]

macos.debug = "res://bin/sandbox_core.macos.template_debug.x86_64.framework/sandbox_core.macos.template_debug.x86_64"
macos.release = "res://bin/sandbox_core.macos.template_release.x86_64.framework/sandbox_core.macos.template_release.x86_64"
windows.debug.x86_64 = "res://bin/sandbox_core.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/sandbox_core.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libsandbox_core.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libsandbox_core.linux.template_release.x86_64.so"
