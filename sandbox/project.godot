; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sandbox"
config/version="1.2.1"
run/main_scene="res://scenes/main/loading_screen.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

VersionManager="*res://scripts/version_manager.gd"
AdMobManager="*res://scripts/admob_manager.gd"
AnalyticsManager="*res://scripts/analytics_manager.gd"
NotificationScheduler="*res://addons/NotificationSchedulerPlugin/NotificationScheduler.gd"
NotificationManager="*res://scripts/notification_manager.gd"
GodotPlayGameServices="*uid://cnutnba63py8a"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
enabled=PackedStringArray("res://addons/NotificationSchedulerPlugin/plugin.cfg", "res://addons/admob/plugin.cfg", "res://addons/GodotPlayGameServices/plugin.cfg")

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotPlayGameServices/plugin.cfg", "res://addons/InappReviewPlugin/plugin.cfg", "res://addons/NotificationSchedulerPlugin/plugin.cfg", "res://addons/admob/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://translations.de.translation", "res://translations.en.translation", "res://translations.es.translation", "res://translations.fr.translation", "res://translations.it.translation", "res://translations.pt.translation")

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
rendering/text/canvas_item/allow_emoji=true
